DATABASE_URL="postgresql://user:password@localhost:5432/examapp"

AUTH_SECRET="generate-with: openssl rand -base64 33"
NEXTAUTH_URL="http://localhost:3000"

# Resend (вход и верификация по почте) — https://resend.com/api-keys (см. README.md)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Балл <onboarding@resend.dev>"

# Куда шлётся уведомление на новое сообщение поддержки (/app/support) — сама
# переписка всегда хранится в базе, это просто "чтобы узнать поскорее".
# Необязательно — по умолчанию bal.support.exam@gmail.com. Тот же Resend, что и выше.
SUPPORT_EMAIL="bal.support.exam@gmail.com"

# Почты, у которых при входе в приложение появляется админ-режим
# (/app/admin/support — видеть и отвечать на все обращения студентов).
# Через запятую, если админов несколько. Необязательно — по умолчанию
# dimitrystaristenko@gmail.com.
ADMIN_EMAILS="dimitrystaristenko@gmail.com"

# Groq (быстрый бесплатный ИИ) — ключ: https://console.groq.com/keys
GROQ_API_KEY=""

# Демо-вход без OAuth (для разработки/тестирования). Отключите в проде.
ENABLE_DEMO_LOGIN="true"
