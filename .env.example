DATABASE_URL="postgresql://user:password@localhost:5432/examapp"

AUTH_SECRET="generate-with: openssl rand -base64 33"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials (см. README.md)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Yandex ID OAuth — https://oauth.yandex.ru (см. README.md)
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# VK ID OAuth — https://id.vk.com/business/go (см. README.md)
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# Groq (быстрый бесплатный ИИ) — ключ: https://console.groq.com/keys
GROQ_API_KEY=""

# Демо-вход без OAuth (для разработки/тестирования). Отключите в проде.
ENABLE_DEMO_LOGIN="true"
