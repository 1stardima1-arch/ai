generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- Auth.js -------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  avatarKey     String?
  nameChangedAt DateTime?
  // Username + password login, independent of the email-magic-link/OAuth
  // providers below — a student can have either, both, or neither.
  username      String?   @unique
  passwordHash  String?
  // Self-assessed preparation level from onboarding: BEGINNER | INTERMEDIATE | ADVANCED.
  // Drives task difficulty selection and how the AI tutor pitches explanations.
  prepLevel     String?
  createdAt     DateTime  @default(now())

  // gamification
  xp               Int       @default(0)
  level             Int       @default(1)
  streak           Int       @default(0)
  longestStreak     Int       @default(0)
  lastPracticeDate  DateTime?
  dailyGoal         Int       @default(10)

  accounts      Account[]
  sessions      Session[]
  attempts      Attempt[]
  mockAttempts  MockExamAttempt[]
  achievements  UserAchievement[]
  chatMessages     AiMessage[]
  enrollments      UserSubject[]
  supportMessages  SupportMessage[]
  authenticators   Authenticator[]
  passwordResets   PasswordResetToken[]

  @@index([xp])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// A registered fingerprint/Face ID/Windows Hello credential (WebAuthn).
// credentialID/credentialPublicKey are stored base64url-encoded — Prisma
// has no raw binary type that round-trips cleanly through Postgres here.
model Authenticator {
  id                  String   @id @default(cuid())
  userId              String
  credentialID        String   @unique
  credentialPublicKey String
  counter             Int
  transports          String?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("authenticators")
}

// Short-lived "forgot password" link. One-time use — consumed (deleted) the
// moment the password is actually reset.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------- Domain -------------------------

enum ExamType {
  EGE
  OGE
}

enum TaskType {
  SHORT_ANSWER
  CHOICE
  MULTI_CHOICE
  MATCHING
  DETAILED_ANSWER
  ESSAY
}

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  examType    ExamType
  description String
  icon        String
  color       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  topics      Topic[]
  tasks       Task[]
  mockExams   MockExam[]
  enrollments UserSubject[]

  @@map("subjects")
}

model UserSubject {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("user_subjects")
}

model Topic {
  id        String  @id @default(cuid())
  subjectId String
  slug      String
  name      String
  order     Int     @default(0)
  theory    String  @db.Text
  summary   String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([subjectId, slug])
  @@map("topics")
}

model Task {
  id             String   @id @default(cuid())
  subjectId      String
  topicId        String
  // Stable per-topic identity (its position in the seed data), NOT shown to
  // users. Lets re-seeding upsert tasks in place instead of delete+recreate,
  // which would otherwise cascade-delete every user's Attempt history for
  // that topic on every deploy. Nullable + backfilled by the seed script
  // (see prisma/seed.ts) rather than a required column, so this migration
  // can't fail `prisma db push` against a database that already has rows.
  slug           String?
  number         Int
  type           TaskType
  statement      String   @db.Text
  // Structured geometry-figure spec for tasks that need one (see
  // src/lib/task-diagram-types.ts) — rendered as inline themed SVG rather
  // than a static image, so it's crisp at any size and correct by
  // construction instead of an AI-generated picture that might mislabel a
  // triangle.
  diagram        Json?
  options        Json?
  correctAnswer  String
  explanation    String   @db.Text
  difficulty     Int      @default(1)
  maxScore       Int      @default(1)
  source         String   @default("Банк заданий ФИПИ (открытый банк, аналог)")
  createdAt      DateTime @default(now())

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts Attempt[]
  mockTasks MockExamTask[]

  @@unique([topicId, slug])

  @@index([subjectId, topicId])
  @@map("tasks")
}

model Attempt {
  id             String   @id @default(cuid())
  userId         String
  taskId         String
  givenAnswer    String
  isCorrect      Boolean
  scoreAwarded   Int      @default(0)
  // Set only when an ESSAY/DETAILED_ANSWER task was graded from a photo of
  // the handwritten answer — the AI's written feedback, kept so results
  // pages can show *why* the score is what it is, not just the number. The
  // photo itself is never persisted (see submitAttemptPhoto).
  aiFeedback     String?  @db.Text
  timeSpentSec   Int      @default(0)
  mockExamAttemptId String?
  createdAt      DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mockExamAttempt MockExamAttempt? @relation(fields: [mockExamAttemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, taskId])
  @@map("attempts")
}

model MockExam {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  durationMin Int
  createdAt   DateTime @default(now())

  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tasks    MockExamTask[]
  attempts MockExamAttempt[]

  @@map("mock_exams")
}

model MockExamTask {
  id         String @id @default(cuid())
  mockExamId String
  taskId     String
  order      Int

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, taskId])
  @@map("mock_exam_tasks")
}

model MockExamAttempt {
  id             String    @id @default(cuid())
  userId         String
  mockExamId     String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  primaryScore   Int       @default(0)
  maxPrimaryScore Int      @default(0)
  gradeEstimate  String?
  status         String    @default("in_progress")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockExam MockExam  @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@map("mock_exam_attempts")
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  xpReward    Int    @default(0)

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String   @db.Text
  taskId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_messages")
}

// One thread per student (userId) — messages from the student and from
// admin replies interleaved, distinguished by fromAdmin.
model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  fromAdmin Boolean  @default(false)
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_messages")
}
